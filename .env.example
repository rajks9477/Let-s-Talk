# =================================================================
# LET'S TALK - APPLICATION ENVIRONMENT CONFIGURATION
# =================================================================

# Server & Networking
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Next.js Client URL & APIs
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/letstalk_db?schema=public"

# Redis (Caching, Presence, Pub/Sub & Queues)
REDIS_URL="redis://localhost:6379"

# Cryptography & Security Secrets
JWT_SECRET="lets-talk-ultra-secure-jwt-secret-key-32-chars-min"
JWT_REFRESH_SECRET="lets-talk-ultra-secure-refresh-token-secret-key"
SESSION_SECRET="lets-talk-session-secret-key-for-cookies"
DATA_ENCRYPTION_KEY="01234567890123456789012345678901" # 32-byte key for AES-256

# Storage (S3 / MinIO / Local FS Fallback)
STORAGE_DRIVER=local # local | s3 | minio | r2
S3_ENDPOINT="https://s3.amazonaws.com"
S3_BUCKET="lets-talk-media"
S3_REGION="us-east-1"
S3_ACCESS_KEY="your-s3-access-key"
S3_SECRET_KEY="your-s3-secret-key"
UPLOAD_LOCAL_PATH="./uploads"

# WebRTC STUN/TURN Calling Servers
STUN_SERVER="stun:stun.l.google.com:19302"
TURN_SERVER="turn:turn.yourdomain.com:3478"
TURN_USERNAME="turn-user"
TURN_PASSWORD="turn-password"

# OTP / SMS Provider Abstraction
OTP_PROVIDER=mock # mock | twilio | aws_sns
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Push Notifications (Web Push, FCM, APNs)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@letstalk.app"
FCM_SERVER_KEY=""
APNS_KEY_ID=""
APNS_TEAM_ID=""

# AI Assistant Providers (Gemini / OpenAI / Anthropic)
AI_DEFAULT_PROVIDER=gemini # gemini | openai | anthropic | mock
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Payments & UPI Sandbox Abstraction
PAYMENTS_SANDBOX_MODE=true
PAYMENTS_MERCHANT_VPA="letstalk.superapp@upi"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
STRIPE_SECRET_KEY=""

# Admin & Moderation
ADMIN_SECRET_TOKEN="admin-master-super-access-token"
